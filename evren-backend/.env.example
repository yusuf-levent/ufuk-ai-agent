# Upstream LLM provider. Dev: evren-llmapi. Later: OpenRouter (switch here only).
UPSTREAM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
UPSTREAM_API_KEY=change-me
# "Authorization" (sends: Authorization: Bearer <key>) or "X-API-Key" (sends: X-API-Key: <key>)
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_TIMEOUT_SECONDS=300

# Security. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900

# Infrastructure (local dev defaults match docker-compose.yml;
# host ports differ from defaults to avoid clashes with a local Postgres/Redis)
DATABASE_URL=postgresql+asyncpg://evren:evren@localhost:5433/evren
REDIS_URL=redis://localhost:6380/0

# App
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAILS=admin@example.com
ENVIRONMENT=dev
REQUEST_MAX_BODY_BYTES=10485760

# Rate limiting (global — protects single OpenRouter key)
# GLOBAL_RATE_LIMIT_PER_MINUTE=60

# Stripe (billing webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_...

# Billing provider (stripe | dodo | dodo_live | paddle | paddle_live)
# BILLING_PROVIDER=dodo
# BILLING_API_KEY=...
# BILLING_WEBHOOK_SECRET=whsec_...

# Observability
# SENTRY_DSN=https://...@sentry.io/...

# Production only (docker-compose.prod.yml / Caddy; see docs/backup-restore.md)
# UFUK_DOMAIN=api.example.com

# --- OpenRouter switch (test env only; do NOT put a real key in production .env) ---
# Verified 2026-09-27 via GET https://openrouter.ai/api/v1/models (public, no key needed):
#   UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
#   UPSTREAM_API_KEY=sk-or-v1-...   (test key only; real key enters prod secrets at cutover)
#   UPSTREAM_AUTH_HEADER=Authorization
# Tier upstream_model_id mapping (evren-llmapi -> OpenRouter, all tools=true):
#   fast      deepseek-v4-flash    -> deepseek/deepseek-v4-flash     ($0.0469/M in,  $0.0938/M out)
#   fast2     deepseek-v4.1-flash  -> deepseek/deepseek-v4.1-flash   ($0.0350/M in,  $0.2900/M out)
#   balanced  gemma-4-31b          -> google/gemma-4-31b-it          ($0.0900/M in,  $0.3400/M out)
#   balanced2 qwen3.8-flash-next   -> qwen/qwen3.8-flash             ($0.1500/M in,  $0.4700/M out)
#   strong    glm-5.3              -> z-ai/glm-5.3                   ($1.4000/M in,  $4.4000/M out)
#   strong2   mimo-v2.6-pro        -> xiaomi/mimo-v2.6-pro           ($0.4350/M in,  $0.8700/M out)
# Update tier rows via admin PATCH /admin/tiers/{id} (or seed env overrides
# SEED_QWEN37_FLASH_MODEL etc.) when switching upstreams.
