# Upstream LLM provider. Dev: evren-llmapi. Later: OpenRouter (switch here only).
UPSTREAM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
UPSTREAM_API_KEY=change-me
# "Authorization" (sends: Authorization: Bearer <key>) or "X-API-Key" (sends: X-API-Key: <key>)
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_TIMEOUT_SECONDS=300

# Security. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900

# Infrastructure (local dev defaults match docker-compose.yml;
# host ports differ from defaults to avoid clashes with a local Postgres/Redis)
DATABASE_URL=postgresql+asyncpg://evren:evren@localhost:5433/evren
REDIS_URL=redis://localhost:6380/0

# App
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAILS=admin@example.com
ENVIRONMENT=dev
REQUEST_MAX_BODY_BYTES=10485760
